<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartBuilding.Application\SmartBuilding.Application.csproj" />
    <ProjectReference Include="..\SmartBuilding.Infrastructure\SmartBuilding.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\database\smartbuildingdb.sql" Link="Database\smartbuildingdb.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
